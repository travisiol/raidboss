# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://raidboss.example

# =======================================================================
# HOW THE RAID GETS ITS STATE
# =======================================================================
# Three modes, picked automatically from what you fill in below. One rules
# engine feeds all three, so the health bar means the same thing in each.
#
#   SIM       nothing configured. The rules run locally, and the page says
#             SIMULATION in the nav, in the arena and on the strike button.
#
#   POOL      you have a token and a pool, and no custom contract. The site
#             watches USDG going into the pool, treats each transfer as a buy,
#             and replays them through the rules from boss I. This is the mode
#             to launch in — nothing has to be deployed but the token.
#             Caveat: liquidity adds look like buys on chain and get counted
#             with them. The page states this where it matters.
#
#   CONTRACT  a purpose-built raid contract exists and reports the arena
#             directly. Set NEXT_PUBLIC_RAID_CONTRACT_ADDRESS and it takes
#             over. See src/lib/raidAbi.ts for the surface it must expose.
#
# Nothing reads a chain at all until LIVE is true.
NEXT_PUBLIC_RAID_LIVE=false

# --- POOL mode ---------------------------------------------------------
# Your token. Holding it is what shows a wallet as being in the raid.
NEXT_PUBLIC_RAID_TOKEN_ADDRESS=
# The pool buys flow through. Damage is read from what arrives here.
NEXT_PUBLIC_RAID_POOL_ADDRESS=
# The quote token. Damage and the pot are denominated in it.
NEXT_PUBLIC_USDG_ADDRESS=
# Block the raid starts counting from — set this to the block the pool
# opened. Left at 0 the site only reads the last 50,000 blocks.
NEXT_PUBLIC_RAID_START_BLOCK=0
# Where the strike button sends a buyer. {amount} is replaced with the USDG
# figure they typed, so they land on the swap with it already filled in.
NEXT_PUBLIC_RAID_DEX_URL=

# --- CONTRACT mode -----------------------------------------------------
# Leave unset unless a raid contract is actually deployed.
NEXT_PUBLIC_RAID_CONTRACT_ADDRESS=

# =======================================================================
# THE RULES
# =======================================================================
# These must match whatever actually enforces them. The site derives every
# forecast, every label and the simulation itself from them, so a mismatch
# shows up as the page quoting damage that will not be dealt.
# Fee taken from each buy, in basis points. 300 = 3%.
NEXT_PUBLIC_RAID_FEE_BPS=300
# Health of boss I, in damage points. One point = one USDG of buying.
NEXT_PUBLIC_RAID_BASE_HEALTH=250000
# Multiplier on each subsequent boss.
NEXT_PUBLIC_RAID_GROWTH=1.75
# Share of a dead boss's pot that seeds the next one. 1000 = 10%.
NEXT_PUBLIC_RAID_CARRY_BPS=1000
# Largest single hit, as a share of a boss's health. 800 = 8%.
NEXT_PUBLIC_RAID_MAX_HIT_BPS=800

# =======================================================================
# CHAIN
# =======================================================================
# Re-verify against https://docs.robinhood.com/chain before pointing this at
# real funds; the defaults in src/lib/chain.ts came from third-party sources.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

# --- Socials (hidden from the footer while unset) -----------------------
NEXT_PUBLIC_RAID_X=
NEXT_PUBLIC_RAID_DISCORD=
