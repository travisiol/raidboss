# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://hydra.example

# --- The raid -----------------------------------------------------------
# Leave the addresses unset until the contracts are deployed. With them unset
# the arena runs the same rules locally, labels itself SIMULATION everywhere,
# and every write control is disabled.
NEXT_PUBLIC_HYDRA_CONTRACT_ADDRESS=
NEXT_PUBLIC_HYDRA_TOKEN_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
# Needs to be true AND all three addresses set before the site reads a chain.
NEXT_PUBLIC_HYDRA_LIVE=false

# --- Rules --------------------------------------------------------------
# These must match what the deployed contract enforces. The site derives every
# forecast, every label and the simulation itself from them, so a mismatch
# shows up as the page quoting damage the chain will not deal.
# Fee taken from each buy, in basis points. 300 = 3%.
NEXT_PUBLIC_HYDRA_FEE_BPS=300
# Health of boss I, in damage points (one point = one USDG of buying).
NEXT_PUBLIC_HYDRA_BASE_HEALTH=250000
# Multiplier on each subsequent boss.
NEXT_PUBLIC_HYDRA_GROWTH=1.75
# Share of a dead boss's pot that seeds the next one. 1000 = 10%.
NEXT_PUBLIC_HYDRA_CARRY_BPS=1000
# Largest single hit, as a share of a boss's health. 800 = 8%.
NEXT_PUBLIC_HYDRA_MAX_HIT_BPS=800

# --- Chain --------------------------------------------------------------
# Re-verify against https://docs.robinhood.com/chain before pointing this at
# real funds; the defaults in src/lib/chain.ts came from third-party sources.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

# --- Socials (hidden from the footer while unset) -----------------------
NEXT_PUBLIC_HYDRA_X=
NEXT_PUBLIC_HYDRA_DISCORD=
